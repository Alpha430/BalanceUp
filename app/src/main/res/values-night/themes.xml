<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BalanceUp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface</item>

        <!-- Status / Nav Bars -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <!-- System Bar Icons (False = Light icons) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Buttons -->
        <item name="materialButtonStyle">@style/Widget.BalanceUp.Button</item>

    </style>

    <style name="Theme.BalanceUp" parent="Base.Theme.BalanceUp" />

</resources>
