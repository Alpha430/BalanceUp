<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================= -->
    <!-- Base Theme -->
    <!-- ============================= -->

    <style name="Base.Theme.BalanceUp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Toolbar / AppBar -->
        <item name="colorSurfaceVariant">@color/surface</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <!-- Fix System Bar Icons -->
        <item name="android:windowLightStatusBar">false</item> <!-- White icons for orange status bar -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Buttons -->
        <item name="materialButtonStyle">@style/Widget.BalanceUp.Button</item>

    </style>

    <style name="Theme.BalanceUp" parent="Base.Theme.BalanceUp" />


    <!-- ============================= -->
    <!-- Button Style -->
    <!-- ============================= -->

    <style name="Widget.BalanceUp.Button" parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>

    </style>

    <!-- Custom Shape for Bottom Card -->
    <style name="ShapeAppearanceOverlay.BottomCard" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ============================= -->
    <!-- Splash Theme -->
    <!-- ============================= -->

    <style name="Theme.BalanceUp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/split_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.BalanceUp</item>
    </style>

</resources>
