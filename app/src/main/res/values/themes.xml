<resources>

    <!-- ============================= -->
    <!-- Base Theme -->
    <!-- ============================= -->

    <style name="Base.Theme.BalanceUp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Toolbar / AppBar -->
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>



        <!-- Buttons -->
        <item name="materialButtonStyle">@style/Widget.BalanceUp.Button</item>

    </style>

    <style name="Theme.BalanceUp" parent="Base.Theme.BalanceUp" />



    <!-- ============================= -->
    <!-- Toolbar Style -->
    <!-- ============================= -->





    <!-- ============================= -->
    <!-- Button Style -->
    <!-- ============================= -->

    <style name="Widget.BalanceUp.Button" parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>

    </style>



    <!-- ============================= -->
    <!-- Splash Theme -->
    <!-- ============================= -->

    <style name="Theme.BalanceUp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/split_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.BalanceUp</item>
    </style>

</resources>
